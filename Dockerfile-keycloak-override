# ---------- Stage 0: build provider jars (Java 21) ----------
FROM maven:3.9-eclipse-temurin-21 AS mvn
WORKDIR /src

# Copy only libs for better cache usage
COPY libs /src/libs

# Build modules that produce providers (skip tests)
RUN mvn -f libs/pom.xml -B -DskipTests -am -pl bundle,internal package

# Gather every produced jar into a single directory
RUN mkdir -p /out/providers \
 && find /src/libs -type f -path "*/target/*" -name "*.jar" -exec cp -v {} /out/providers/ \; || true

# ---------- Stage 1: prepare Keycloak with providers ----------
FROM quay.io/phasetwo/keycloak-crdb:26.4.2 AS builder

ENV KC_METRICS_ENABLED=true \
    KC_HEALTH_ENABLED=true \
    KC_FEATURES=preview

# Infinispan jdbc_ping config
COPY conf/cache-ispn-jdbc-ping.xml /opt/keycloak/conf/cache-ispn-jdbc-ping.xml

# 3rd-party providers from repo
COPY libs/ext/*.jar /opt/keycloak/providers/

# Providers built in Stage 0 (single copy; works even if directory is empty)
COPY --from=mvn /out/providers/ /opt/keycloak/providers/

# Pre-build to optimize startup
RUN /opt/keycloak/bin/kc.sh --verbose build \
    --spi-email-template-provider=freemarker-plus-mustache \
    --spi-email-template-freemarker-plus-mustache-enabled=true \
    --spi-theme-cache-themes=false

# ---------- Stage 2: final runtime image ----------
FROM quay.io/phasetwo/keycloak-crdb:26.4.2

USER 1000
WORKDIR /opt/keycloak

COPY --from=builder /opt/keycloak/lib/quarkus/ /opt/keycloak/lib/quarkus/
COPY --from=builder /opt/keycloak/providers/ /opt/keycloak/providers/
COPY --from=builder /opt/keycloak/conf/cache-ispn-jdbc-ping.xml /opt/keycloak/conf/cache-ispn-jdbc-ping.xml
